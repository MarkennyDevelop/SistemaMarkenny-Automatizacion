{
  "name": "markenny-print-mis",
  "private": true,
  "description": "Print MIS / ERP para la imprenta Markenny C.A. (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev --workspace apps/backend",
    "migrate": "npm run migrate --workspace apps/backend",
    "openapi": "npm run openapi --workspace packages/contrato",
    "seed:demo": "npm run seed:demo --workspace apps/backend"
  },
  "engines": {
    "node": ">=20"
  }
}
