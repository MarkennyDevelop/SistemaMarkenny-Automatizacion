# Copia este archivo como .env (en apps/backend) y ajusta los valores.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Sin DATABASE_URL el backend usa repositorios en memoria (los datos se pierden al reiniciar).
DATABASE_URL=postgres://postgres:markenny12345@localhost:5432/markenny_mis

# Horas de validez de una sesión.
SESION_HORAS=12
# Cookie solo por HTTPS. Por defecto: true en producción, false en desarrollo.
# COOKIE_SEGURA=true
